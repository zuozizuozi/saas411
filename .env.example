# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Get your database URL from your PostgreSQL provider (Neon, Supabase, etc.)
# -----------------------------------------------------------------------------
# On Vercel use the Supabase transaction pooler URL (port 6543).
DATABASE_URL='postgresql://user:password@host:6543/database?sslmode=require'
# Optional: Override SSL mode (disable | require). Auto-detected based on hostname if not set.
# Useful for Docker/internal deployments where SSL is not needed.
# DATABASE_SSL_MODE=disable

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL='http://localhost:3000'
# Billing is deliberately single-provider: Stripe.
NEXT_PUBLIC_BILLING_PROVIDER="stripe"

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# Generate a new secret with: openssl rand -base64 32
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET='your_better_auth_secret_here'

# Google OAuth (Get credentials from: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID='your_google_client_id'
GOOGLE_CLIENT_SECRET='your_google_client_secret'

# -----------------------------------------------------------------------------
# Email (RESEND)
# Get your API key from: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY='re_your_resend_api_key'
RESEND_FROM='seedance.co <noreply@seedance.co.com>'

# -----------------------------------------------------------------------------
# Subscriptions and one-time credit packs (Stripe)
# -----------------------------------------------------------------------------
STRIPE_API_KEY="sk_test_your_stripe_api_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_BASIC_MONTHLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_BASIC_QUARTERLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_BASIC_YEARLY_PRICE_ID="price_xxx"

NEXT_PUBLIC_STRIPE_PRO_PRODUCT_ID="prod_xxx"
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_PRO_QUARTERLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_BUSINESS_PRODUCT_ID="prod_xxx"
NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_BUSINESS_QUARTERLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_BUSINESS_YEARLY_PRICE_ID="price_xxx"

# -----------------------------------------------------------------------------
# Analytics (PostHog) - Optional
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY="your_posthog_key"
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Analytics (Plausible) - Optional
# Self-hosted or cloud Plausible analytics
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js

# -----------------------------------------------------------------------------
# Admin Account
# Set your email to automatically grant admin permissions
# -----------------------------------------------------------------------------
ADMIN_EMAIL="your-email@example.com"

# -----------------------------------------------------------------------------
# Debug Mode
# -----------------------------------------------------------------------------
IS_DEBUG=false

# -----------------------------------------------------------------------------
# R2/S3 Storage
# Get your credentials from Cloudflare R2 or AWS S3
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=https://xxx.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your_r2_access_key_id
STORAGE_SECRET_KEY=your_r2_secret_access_key
STORAGE_BUCKET=your_bucket_name
STORAGE_DOMAIN=https://pub-xxx.r2.dev
# Maximum provider output downloaded into a Vercel function (default 250 MiB).
MAX_VIDEO_DOWNLOAD_BYTES=262144000

# -----------------------------------------------------------------------------
# AI Video Providers
# Get your API keys from the respective providers
# -----------------------------------------------------------------------------
# Evolink: https://evolink.ai
EVOLINK_API_KEY=sk-your_evolink_api_key
# Optional override for testing/proxying. Defaults to https://api.evolink.ai/v1
# EVOLINK_BASE_URL=https://api.evolink.ai/v1

# Kie.ai: https://kie.ai
KIE_API_KEY=your_kie_api_key

# APImart: https://apimart.ai (supports Seedance 1.0/1.5, Sora 2, Wan 2.6, Veo 3.1)
APIMART_API_KEY=your_apimart_api_key

# Alibaba Cloud Model Studio (Bailian / Wan 2.7 video generation)
BAILIAN_API_KEY=sk-your_bailian_api_key
BAILIAN_T2V_MODEL=wan2.7-t2v
BAILIAN_I2V_MODEL=wan2.7-i2v
# Optional. Defaults to the existing Beijing DashScope endpoint.
# Prefer your workspace-specific Beijing URL ending in /api/v1 when available.
# BAILIAN_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1

# Zhipu BigModel: https://bigmodel.cn (video generation)
ZHIPU_API_KEY=your_zhipu_api_key
# Provider model can be changed without a code deploy.
ZHIPU_VIDEO_MODEL=cogvideox-flash

# Optional provider pin (evolink | kie | apimart | bailian | zhipu).
# Leave unset to use the per-model route and configured fallbacks in src/ai/routing.ts.
# Set it only while deliberately forcing the whole site through one provider.
# DEFAULT_AI_PROVIDER=evolink

# -----------------------------------------------------------------------------
# AI Callback (REQUIRED for production)
# Set this to your domain in production
# Local development: use localhost:3000 (callbacks won't work, polling will handle it)
# Production: use your actual domain (e.g., https://seedance.co.com)
# -----------------------------------------------------------------------------
AI_CALLBACK_URL=https://yourdomain.com/api/v1/video/callback
AI_PROVIDER_TIMEOUT_MS=30000
CALLBACK_HMAC_SECRET=generate_random_secret_here

# -----------------------------------------------------------------------------
# Durable task execution (Upstash Workflow / QStash)
# Optional locally. Required in production to retry missed provider callbacks.
# -----------------------------------------------------------------------------
QSTASH_TOKEN=qstash_your_token
QSTASH_URL=https://qstash.upstash.io
QSTASH_CURRENT_SIGNING_KEY=sig_current_key
QSTASH_NEXT_SIGNING_KEY=sig_next_key

# -----------------------------------------------------------------------------
# Credit & Pricing System (积分与商品配置)
# 所有商品 ID、价格、积分数量统一在 src/config/pricing-user.ts 中管理
# 无需在环境变量中配置
# -----------------------------------------------------------------------------
