diff --git a/src/components/credits/credit-history-contract.regression.test.ts b/src/components/credits/credit-history-contract.regression.test.ts
new file mode 100644
--- /dev/null
+++ b/src/components/credits/credit-history-contract.regression.test.ts
@@ -0,0 +1,19 @@
+import { readFileSync } from "node:fs";
+import { expect, it } from "vitest";
+
+it.fails("BUG-008 / REQ-013: every credit-history API alias has an English locale key", () => {
+  const route = readFileSync(
+    "src/app/api/v1/credit/history/route.ts",
+    "utf8"
+  );
+  const mapping = route.slice(
+    route.indexOf("const transTypeMapping"),
+    route.indexOf("export async function GET")
+  );
+  const aliases = [...mapping.matchAll(/:\s*"([a-z_]+)"/g)].map(
+    (match) => match[1]
+  );
+  const messages = JSON.parse(readFileSync("src/messages/en.json", "utf8"));
+  const keys = Object.keys(messages.dashboard.credits.types);
+  expect(aliases.filter((alias) => !keys.includes(alias))).toEqual([]);
+});
